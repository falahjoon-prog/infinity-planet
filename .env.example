# =====================================================================
# RHC City V4 — server configuration (.env.local)
# Copy this file to .env.local on the RHC server PC and fill it in.
# NEVER share this file. Team PCs and phones do not need it.
# =====================================================================

# --- Supabase (required) — Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public address of this server (used for Google OAuth redirect)
RHC_PUBLIC_URL=http://localhost:3300
# Let staff with these email domains request an account on the sign-in page (an admin approves each one)
SIGNUP_DOMAINS=rhccity.com.au

# --- AI providers (all optional — Legal AI, Designer and Search work without any key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (local AI). Default is Ollama's own API on port 11434.
# To go through Open WebUI instead: OLLAMA_BASE_URL=http://localhost:3000/ollama and set OLLAMA_API_KEY
# to an Open WebUI API key (Open WebUI → Settings → Account → API keys).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=
# Set to false to hide Ollama entirely
OLLAMA_ENABLED=true

# --- Google Workspace: Gmail, Calendar, Drive (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3300/api/google/callback
# Random secret, 32+ characters. Encrypts the stored Google refresh token. Do not change once Google is connected.
GOOGLE_ENCRYPTION_KEY=

# --- Optional
RHC_HOME_JURISDICTION=Queensland
# Shared secret for server-to-server calls without a user session (rarely needed)
RHC_INTERNAL_API_KEY=
