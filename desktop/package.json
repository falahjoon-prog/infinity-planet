{
  "name": "rhc-city-desktop",
  "productName": "Infinity Planet",
  "version": "4.1.0",
  "description": "Infinity Planet business operating system — desktop app",
  "author": "Infinity Planet",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win-portable": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "city.rhc.desktop",
    "productName": "Infinity Planet",
    "copyright": "Infinity Planet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "config.default.json",
      "build/tray.png",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Infinity-Planet-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Infinity Planet"
    },
    "portable": {
      "artifactName": "Infinity-Planet-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}